# EMS backend configuration — PLACEHOLDERS ONLY.
#
# Copy to .env for local development and replace every value marked REPLACE_ME.
# .env is gitignored and must never be committed. Production secrets belong in a managed
# secrets store, not in a file (§25.9).
#
# Generate the three secrets with:
#   python -m app.cli generate-keys
# which prints fresh values for SECRET_KEY, ENCRYPTION_MASTER_KEY and BLIND_INDEX_MASTER_KEY.

# ----------------------------------------------------------------- application
APP_NAME="Employee Management System"
ENVIRONMENT=local                  # local | test | staging | production
DEBUG=true                         # must be false when ENVIRONMENT is staging/production
API_PREFIX=/api/v1

# Comma-separated. Must not contain "*" in staging/production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------- database
# MySQL 8.0+ only (ADR-002). The database must exist; the application never creates it.
#   CREATE DATABASE ems CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql+pymysql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@127.0.0.1:3306/ems?charset=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# Lock-wait ceiling: exceeding it returns a retryable 409 CONCURRENT_MODIFICATION (§24.3).
DB_LOCK_WAIT_TIMEOUT_SECONDS=10
# Logs SQL including bound parameters, which are personal data. Never enable outside local.
DB_ECHO=false

# ----------------------------------------------------------------- secrets and tokens
# Signs local access tokens and pagination cursors. At least 32 characters, high entropy.
SECRET_KEY=REPLACE_ME_WITH_A_32_PLUS_CHARACTER_RANDOM_SECRET

# NFR-13: access tokens live at most 15 minutes; sessions at most 12 hours.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=12
TOKEN_ALGORITHM=HS256
TOKEN_ISSUER=ems-backend
TOKEN_AUDIENCE=ems-api

# OIDC is the primary identity strategy (§24.1, A-04). All three must be set together.
# Left blank here: no identity provider is configured. See docs/AUTH.md.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_SECONDS=3600

# Local password accounts: the documented fallback. NFR-12 requires MFA for privileged
# roles, which local login cannot provide, so staging/production must configure OIDC.
LOCAL_LOGIN_ENABLED=true

# ----------------------------------------------------------------- encryption (§23.7)
# env = master keys from this file (development only).
# kms = per-organization DEKs wrapped by a managed KMS. Required in staging/production.
KEY_PROVIDER=env

# base64-encoded 32 bytes each. MUST be different from each other: §23.7 requires
# blind-index keys to be separate from encryption keys.
ENCRYPTION_MASTER_KEY=REPLACE_ME_BASE64_32_BYTES
BLIND_INDEX_MASTER_KEY=REPLACE_ME_DIFFERENT_BASE64_32_BYTES
ENCRYPTION_KEY_VERSION=1

# Used when KEY_PROVIDER=kms.
KMS_KEY_ID=
KMS_ENDPOINT=

# ----------------------------------------------------------------- document storage (§15)
# local = a private directory (development only). s3 = private object storage.
STORAGE_BACKEND=local
# MUST NOT be inside any directory served as static content.
STORAGE_LOCAL_ROOT=./var/private-storage

STORAGE_S3_BUCKET=
STORAGE_S3_QUARANTINE_BUCKET=
# NFR-21 / Q-09 assume India-only hosting. Set the region deliberately; nothing is defaulted.
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=

UPLOAD_URL_TTL_SECONDS=900         # §15.4: 15 minutes
DOWNLOAD_URL_TTL_SECONDS=300       # §15.6: 5 minutes

# ----------------------------------------------------------------- malware scanning (A-06)
# noop = accept without scanning (development only; staging/production require external).
MALWARE_SCANNER_BACKEND=noop
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------- behaviour limits
PERMISSION_CACHE_TTL_SECONDS=60    # §5.5: changes take effect within 60 seconds
IDENTIFIER_REVEAL_RATE_PER_HOUR=30 # §24.3 [ASSUMPTION], see DECISIONS.md DEC-025
IDEMPOTENCY_RETENTION_HOURS=24     # §24.1
DEFAULT_PAGE_SIZE=25               # §26.5
MAX_PAGE_SIZE=100
EXACT_TOTAL_COUNT_LIMIT=10000      # §26.5
CURSOR_TTL_SECONDS=86400           # §26.5: cursors valid 24 hours
AUDIT_MAX_QUERY_DAYS=366           # §24.4.8

# ----------------------------------------------------------------- logging
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | text

# ------------------------------------------------- first-run bootstrap (development only)
# Read only by `python -m app.cli seed` and `python -m app.cli bootstrap`, and only when the
# database holds no users and no organizations. On such a database the bootstrap creates one
# organization and one local administrator holding SSA + OA + HRA, which is every permission
# in the §5.3 matrix. Once any user or organization exists it is a no-op, so re-running the
# seed can never re-provision an administrator.
#
# SEED_ADMIN_PASSWORD must be at least 12 characters (MIN_PASSWORD_LENGTH) and is a known
# credential in a plaintext file: the application refuses to start with it set when
# ENVIRONMENT is staging or production (§19, §25.9). Change it after the first sign-in.
# The organization's registered address and entity type are placeholders; correct them with
# PATCH /organizations/{id} before entering real data.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456
ORGANIZATION_NAME=test

