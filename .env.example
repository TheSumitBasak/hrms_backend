# Application
APP_NAME="Keka-style HRMS"
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api

# Database — MySQL 8 in production.
# The app creates the schema if missing; use Alembic for production migrations.
DATABASE_URL=mysql+pymysql://root:admin@127.0.0.1:3306/hrms?charset=utf8mb4

# SQLite is still supported as a fallback (handy for quick local runs/tests):
# DATABASE_URL=sqlite:///./hrms.db

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Defaults used by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# Set true to automatically seed demo data at startup when the DB is empty.
AUTO_SEED=false
